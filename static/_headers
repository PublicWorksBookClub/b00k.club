# Docs: https://developers.cloudflare.com/pages/platform/headers

# Ask to deny search engine indexing for not "production" deployments
https://:project.pages.dev/*
  X-Robots-Tag: noindex

# Using Cloudflare with CSP: https://developers.cloudflare.com/fundamentals/get-started/reference/content-security-policies/
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval' static.cloudflareinsights.com ajax.cloudflare.com; style-src 'self' 'unsafe-inline'; style-src-attr 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; prefetch-src 'self'; child-src 'none'; frame-src 'none'; worker-src 'self' 'wasm-unsafe-eval'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; manifest-src 'self'
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer-when-downgrade
  Permissions-Policy: accelerometer=(), ambient-light-sensor=(), autoplay=(), battery=(), camera=(), cross-origin-isolated=(), display-capture=(), document-domain=(), encrypted-media=(), execution-while-not-rendered=(), execution-while-out-of-viewport=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), navigation-override=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), sync-xhr=(), usb=(), web-share=(), xr-spatial-tracking=(), clipboard-read=(), clipboard-write=(), gamepad=(), speaker-selection=(), conversion-measurement=(), focus-without-user-activation=(), hid=(), idle-detection=(), serial=(), sync-script=(), trust-token-redemption=(), vertical-scroll=()
  Feature-Policy: default 'none'
  X-XSS-Protection: 1; mode=block

# The ornament studio at /demos/* needs one directive relaxed, and only one.
#
# It draws a page by measuring it and scaling to fit, which means writing
# `element.style` at run time -- and Chromium checks CSSOM writes to an inline
# style against `style-src-attr`, not only `style` attributes in the markup. With
# the site policy as it stands that is 47 refusals and a studio that renders
# nothing. `style-src` already allows inline, so this only brings the -attr
# directive into line with it.
#
# `script-src` is deliberately NOT relaxed: the studio ships as same-origin
# module files rather than as its usual single inline bundle, so 'self' covers
# it. No third-party origin is added either. Rebuild with
# `python3 tools/t4zh1b-demo.py`.
/demos/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval' static.cloudflareinsights.com ajax.cloudflare.com; style-src 'self' 'unsafe-inline'; style-src-attr 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; prefetch-src 'self'; child-src 'none'; frame-src 'none'; worker-src 'self' 'wasm-unsafe-eval'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; manifest-src 'self'
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer-when-downgrade
  Feature-Policy: default 'none'
  X-XSS-Protection: 1; mode=block

# The flashcards at /flashcards/* deliberately have no block of their own: they
# run under the site policy above as it stands. The study script is a
# same-origin module, the occlusion masks are SVG attributes rather than inline
# style, and everything a deck loads -- index.json, deck.json, media/, the
# .apkg -- comes from this origin, inside `connect-src` and `img-src 'self'`.
#
# Keep it that way when teaching it more of Anki. The one change in sight is
# sound: with `default-src 'none'` an <audio> is refused until there is a
# `media-src 'self'`, which would go in a /flashcards/* block like /demos/*,
# replacing the policy whole rather than adding a second one.

# More liberal CSP below is sandboxed at /maps/*
/maps/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' static.cloudflareinsights.com https://storage.googleapis.com 'unsafe-inline' https://cdn.openwidget.com https://api.openwidget.com/; style-src 'self' 'unsafe-inline'; style-src-attr 'self' 'unsafe-inline'; img-src 'self' *.public-works.pages.dev; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' https://cloudflareinsights.com https://fonts.gstatic.com https://cdn.openwidget.com; prefetch-src 'self'; child-src https://azgaar.github.io; frame-src https://azgaar.github.io https://cdn.openwidget.com; worker-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; manifest-src 'self'
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer-when-downgrade
  Permissions-Policy: accelerometer=(), ambient-light-sensor=(), autoplay=(), battery=(), camera=(), cross-origin-isolated=(), display-capture=(), document-domain=(), encrypted-media=(), execution-while-not-rendered=(), execution-while-out-of-viewport=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), navigation-override=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), sync-xhr=(), usb=(), web-share=(), xr-spatial-tracking=(), clipboard-read=(), clipboard-write=(), gamepad=(), speaker-selection=(), conversion-measurement=(), focus-without-user-activation=(), hid=(), idle-detection=(), serial=(), sync-script=(), trust-token-redemption=(), vertical-scroll=()
  Feature-Policy: default 'none'
  X-XSS-Protection: 1; mode=block
